menu "Inspection Station Wi-Fi"

    config INSPECTION_WIFI_SSID
        string "Hotspot name (SSID)"
        default ""

    config INSPECTION_WIFI_PASSWORD
        string "Hotspot password"
        default ""

endmenu

menu "Inspection Station TCP"
    config INSPECTION_TCP_PORT
        int "TCP listening port"
        range 1024 65535
        default 5001
endmenu
